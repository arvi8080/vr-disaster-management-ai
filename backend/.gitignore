# ==========================================
# Node.js / Express Backend .gitignore
# ==========================================

# Dependencies
node_modules/
.npm/

# Environment Variables & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Firebase & Cloud Credentials
firebase-service-account.json
serviceAccountKey.json
*.pem
*.key
*.crt

# Build & Compilation Outputs
dist/
build/
bin/

# Logs & Runtime
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Local Stores
*.sqlite
*.sqlite3
*.db
uploads/

# Testing & Coverage
coverage/
.nyc_output/
.jest/

# OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
