dist/
dist-ssr/
build/
out/
*.local

# Environment Variables & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Cache
coverage/
.eslintcache
.vite/
.cache/

# OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
